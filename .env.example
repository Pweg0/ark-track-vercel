# Senha única compartilhada com a tribo pra acessar o site
SITE_PASSWORD=troque-esta-senha

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Discord (canal > Editar Canal > Integrações > Webhooks > Novo Webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Upstash QStash (console.upstash.com > QStash > seu token)
QSTASH_TOKEN=coloque-o-token-aqui

# URL pública do seu site depois do deploy (ex: https://ark-tracker.vercel.app)
# Usado pelo QStash pra saber pra onde chamar de volta quando o timer zera.
APP_URL=https://seu-projeto.vercel.app

# Qualquer string aleatória e secreta, só pra validar que a chamada do
# webhook de timer realmente veio do seu QStash (gere uma com: openssl rand -hex 16)
INTERNAL_WEBHOOK_SECRET=gere-uma-string-aleatoria-aqui
